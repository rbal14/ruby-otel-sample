#!/bin/bash
set -e

rm -f ./tmp/pids/server.pid

# MySQL in Kubernetes is usually still starting when the app pods first roll,
# so block here instead of crash-looping the container.
if [ -n "$DB_HOST" ] && [ "${WAIT_FOR_DB:-true}" = "true" ]; then
  echo "waiting for mysql at ${DB_HOST}:${DB_PORT:-3306} ..."
  for i in $(seq 1 60); do
    if mysqladmin ping \
        --host="$DB_HOST" \
        --port="${DB_PORT:-3306}" \
        --user="${DB_USERNAME:-root}" \
        --password="${DB_PASSWORD}" \
        --silent >/dev/null 2>&1; then
      echo "mysql is up"
      break
    fi
    sleep 2
  done
fi

exec "$@"

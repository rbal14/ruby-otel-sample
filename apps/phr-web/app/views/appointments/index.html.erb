<% content_for :title, "Appointments" %>
<h1>Appointments</h1>
<p class="sub">
  Served by <code>phr-api</code> over HTTP &middot; <%= number_with_delimiter @total %> total &middot; page <%= @page %>
</p>

<div class="toolbar">
  <%= form_with url: appointments_path, method: :get, local: true do %>
    <%= select_tag :status,
          options_for_select([["All statuses", ""]] + %w[scheduled confirmed completed cancelled no_show].map { |s| [s.tr("_", " "), s] }, params[:status]),
          onchange: "this.form.requestSubmit()" %>
  <% end %>
</div>

<div class="panel">
  <table>
    <thead><tr><th>Scheduled</th><th>Lead</th><th>Rep</th><th>Branch</th><th>Status</th><th>Outcome</th><th class="num">Quoted</th></tr></thead>
    <tbody>
      <% if @appointments.empty? %>
        <tr><td colspan="7" class="empty">No appointments returned.</td></tr>
      <% end %>
      <% @appointments.each do |appointment| %>
        <% lead = appointment["lead"] || {} %>
        <tr>
          <td><%= appointment["scheduled_at"] %></td>
          <td>
            <% if lead["id"] %>
              <%= link_to "#{lead['first_name']} #{lead['last_name']}", lead_path(lead["id"]) %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= appointment["rep_name"] %></td>
          <td><%= appointment["branch"] %></td>
          <td><%= status_badge appointment["status"] %></td>
          <td><%= humanize_key appointment["outcome"] %></td>
          <td class="num"><%= money appointment["quoted_amount"] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="pager">
  <% if @page > 1 %><%= link_to "‹ Previous", appointments_path(page: @page - 1, status: params[:status]), class: "btn ghost" %><% end %>
  <% if @page * @per_page < @total %><%= link_to "Next ›", appointments_path(page: @page + 1, status: params[:status]), class: "btn ghost" %><% end %>
  <span>showing <%= @appointments.size %> of <%= number_with_delimiter @total %></span>
</div>

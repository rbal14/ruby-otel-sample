# Optional. Copy to .env to override the docker-compose defaults.
# The Kubernetes deployment reads its equivalents from k8s/10-secrets.yaml.
MYSQL_ROOT_PASSWORD=poc-root-pw-change-me
MYSQL_USER=phr_app
MYSQL_PASSWORD=poc-app-pw-change-me
WEB_DB_NAME=phr_web
API_DB_NAME=phr_api
DT_MONITOR_USER=dtmonitor
DT_MONITOR_PASSWORD=poc-monitor-pw-change-me

# ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

SEED_LEAD_COUNT=400
SEED_CUSTOMER_COUNT=150
RAILS_LOG_LEVEL=info
